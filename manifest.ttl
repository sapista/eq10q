@prefix lv2:  <http://lv2plug.in/ns/lv2core#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix ui:         <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid:       <http://lv2plug.in/ns/ext/urid#> .
@prefix eq10q_gtk2: <http://eq10q.sourceforge.net/lv2-gtk2-ui-bridge> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .

# -----------------------------------------------------------------------------
# Common Bundle Metadata
# -----------------------------------------------------------------------------
<http://sapaudio.es/prafols#me>
	a foaf:Person ;
	foaf:name "Pere Ràfols Soler" ;
	foaf:mbox <mailto:info@sapaudio.es> ;
	foaf:homepage <https://sapaudio.es> .

<http://sapaudio.es/plugins>
	a doap:Project ;
	doap:maintainer <http://sapaudio.es/prafols#me> ;
	doap:name "EQ10Q plugins" .

# -----------------------------------------------------------------------------
# UI Bridge Definition
# -----------------------------------------------------------------------------
eq10q_gtk2:
    a ui:X11UI ;
    lv2:extensionData ui:idleInterface ;
    lv2:requiredFeature ui:parent , urid:map ;
    ui:binary <eq10q-gtk-ui-bridge.so> .

